   9 10 11      2       180.0   25.0
  10 11 12      2       180.0   25.0
   6 13 14 	2 	180.0 	25.0 	
  13 14 15 	2 	180.0 	25.0 	
  14 15 16 	2 	180.0 	25.0
 
[dihedrals]
;  i  j  k  l 	funct 	angle 	force.c.
; 3  1  4  5  1  -30.0  5.0  1 ; Removed as it was unstable - WARNING has not been tested

[constraints]
;  i  j  k 	funct 	length
#ifndef FLEXIBLE
; Using constraints not bonds
