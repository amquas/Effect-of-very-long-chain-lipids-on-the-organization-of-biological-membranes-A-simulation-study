;;;;;; Martini lipid topology for ergosterol
;
; Description:
;   A Martini model for ergosterol, based on the use of virtual sites.
; Parameterization:
;   Adapted from the cholesterol topology. The type of beads 3 and 7 was adjusted, the C1-C2 bond shrunk, and an angle
;   potential added on angle R5-C1-C2. See Melo et al. 2015.
; Reference(s): 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f 
;   M.N. Melo, H.I. Ingolfsson, S.J. Marrink. Parameters for Martini sterols and hopanoids based on a virtual-site description.
;   JCP, 143:243152, 2015. doi:10.1063/1.4937783
; Created: 2015.09
; Warning(s)/Note(s):
;   Note, Runs at 40fs timestep; the manual suggests that triangle constraints with virtual sites and large timesteps (exactly 
;   this case) should use lincs-order=6. Even more precise lincs-order=8 and lincs-iter=2 were used during parameterization; the 
;   performance penalty, even on a 30% sterol membrane, is small.
;   Add define=-DFLEXIBLE to select harmonic bonds for minimization purposes.
;

[ moleculetype ]
; molname  nrexcl
  ERGO     1

[ atoms ]
; i type resnr residue atom cgnr charge mass
  1 SP1  1     ERGO   ROH  1    0.0    77.22
  2 SC1  1     ERGO   R1   2    0.0      0.0
  3 SC4  1     ERGO   R2   3    0.0    38.69
  4 SC1  1     ERGO   R3   4    0.0   159.65
  5 SC1  1     ERGO   R4   5    0.0      0.0
  6 SC1  1     ERGO   R5   6    0.0      0.0
  7 SC3  1     ERGO   C1   7    0.0    39.44
  8  C1  1     ERGO   C2   8    0.0     72.0

[ bonds ]
; i  j  funct  length  force
  7  8  1      0.395   1250.0
#ifdef FLEXIBLE
  1  3  1    0.4904  1000000 
  1  4  1    0.6019  1000000
  3  4  1    0.2719  1000000 
  7  3  1    0.7237  1000000
  7  4  1    0.5376  1000000
#else
[ constraints ]
  1  3  1    0.4904 
  1  4  1    0.6019 
  3  4  1    0.2719 
  7  3  1    0.7237 
  7  4  1    0.5376 
#endif

[ dihedrals ]
  1  3  4  7   2  -179.7  50

[ virtual_sites3 ]
; In-plane bead from frame 4-3-7 (bead 5)
  5  4  3  7   1  0.9613  0.6320 
; Out-of-plane bead from frame 3-1-4 (bead 2)
  2  3  1  4   4  0.5207  0.2882  -0.83824 
; Out-of-plane bead from frame 4-3-7 (bead 6)
  6  4  3  7   4  0.2287  0.4111   1.1531 

[ angles ]
; i  j  k  funct  angle  force
  4  7  8  2      180.0  25.0
  6  7  8  2      180.0  50.0

[ exclusions ]
; i  j  k  ...
  1  2  3  4  5  6  7
  2  3  4  5  6  7
  3  4  5  6  7
  4  5  6  7
  5  6  7
  6  7

;;;;;; Martini lipid topology for di-C16:0-C18:0 PI (DPPI), generated using:
; The Martini lipid itp generator version 0.4  Args are: -o martini_v2.0_DPPI_01.itp -alname DPPI -alhead 'PI' -allink 'G G' -altail 'CCCC CCCC'
; WARNING: Lipids topology was generated following the Martini 2.0 guidelines but this specific lipid type might
;          not have been tested and should therefore be used with care. 
;
; Description:
;   A general model phosphatidylinositol (PI) lipid corresponding to atomistic C16:0 dipalmitoyl (DPPI) - 
;   C18:0 distearoyl (DSPI) tails.
; Parameterization:
;   The lipid head is based on atomistic phosphatidylinositol (PI) simulations, see Lopez et al. 2013 for details. 
;   The lipid tail follows the standard Martini 2.0 lipid definitions and building block rules.
; Reference(s): 
;   C.A. Lopez, Z. Sovova, F.J. van Eerden, A.H. de Vries, S.J. Marrink. Martini force field parameters for glycolipids. JCTC, 
;   9:1694-1708, 2013. doi:10.1021/ct3009655 
;   H.I. Ingolfsson, M.N. Melo, F.J. van Eerden, C. Arnarez, C.A. Lopez, T.A. Wassenaar, X. Periole, A.H. De Vries, D.P. Tieleman, 
;   S.J. Marrink. Lipid organization of the plasma membrane. JACS, 136:14554-14559, 2014. doi:10.1021/ja507832e 
;   S.J. Marrink, A.H. de Vries, A.E. Mark. Coarse grained model for semi-quantitative lipid simulations. JPC-B, 108:750-760, 
;   2004. doi:10.1021/jp036508g 
;   S.J. Marrink, H.J. Risselada, S. Yefimov, D.P. Tieleman, A.H. de Vries. The MARTINI force field: coarse grained model for 
;   biomolecular simulations. JPC-B, 111:7812-7824, 2007. doi:10.1021/jp071097f
; Created: 2015.04.20
; Author(s): Cesar Lopez <C.A.Lopez-Bautista@rug.nl>
; Modified:
;   Helgi I. Ingolfsson <h.i.ingolfsson@rug.nl> and Xavier Periole <x.periole@rug.nl>, 2014.06. 
;   Removed dihedral to increase stability.
; Warning(s)/Note(s):
;   Warning, dihedral for head oriantation was removed to make the molecule more stable - this should be 
;   better tested and compaired to atomistic simulations. 
;   Node, bonds with force constant > 25000 are treated as constraints, but use harmonic bonds for minimization. 
;   Add define=-DFLEXIBLE to .mdp options to select harmonic bonds for minimization purposes.
;
;@INSANE alhead=PI, allink=G G, altail=CCCC CCCC, alname=DPPI, charge=-1.0
;@RESNTEST DPP==DPPI if: atoms[0]==C1  and atoms[4]==GL1
;@BEADS C1 C2 C3 PO4 GL1 GL2 C1A C2A C3A C4A C1B C2B C3B C4B 
;@BONDS C1-C2 C1-C3 C2-C3 C1-PO4 PO4-GL1 GL1-GL2 GL1-C1A C1A-C2A C2A-C3A C3A-C4A GL2-C1B C1B-C2B C2B-C3B C3B-C4B 
;
;manuell angepasst für DPPI mit tailC18:0/26:0
;

[moleculetype]
; molname      nrexcl
  loPI          1

[atoms]
; id 	type 	resnr 	residu 	atom 	cgnr 	charge
   1 	P1 	 1 	loPI 	C1  	 1 	0 	
   2 	P4 	 1 	loPI 	C2  	 2 	0 	
   3 	P4 	 1 	loPI 	C3  	 3 	0 	
   4 	Qa 	 1 	loPI 	PO4 	 4 	-1.0 	; Name changed from CP to PO4
; Tail part (uses standar Martini v2.0 tail rules)
   5 	Na 	 1 	loPI 	GL1 	 5 	0 	
   6 	Na 	 1 	loPI 	GL2 	 6 	0 	
   7 	C1 	 1 	loPI 	C1A 	 7 	0 	
   8 	C1 	 1 	loPI 	C2A 	 8 	0 	
   9 	C1 	 1 	loPI 	C3A 	 9 	0 	
  10 	C1 	 1 	loPI 	C4A 	10 	0 	
  11    C1       1      loPI   C5A     11      0    ;hinzugefügt
  12    C1       1      loPI   C6A     12      0    ;hinzugefügt
  13    C1       1      loPI   C1B     13      0
  14    C1       1      loPI   C2B     14      0
  15    C1       1      loPI   C3B     15      0 
  16    C1       1      loPI   C4B     16      0
;  11 	C1 	 1 	loPI 	C1B 	11 	0 	
;  12 	C1 	 1 	loPI 	C2B 	12 	0 	
;  13 	C1 	 1 	loPI 	C3B 	13 	0 	
;  14 	C1 	 1 	loPI 	C4B 	14 	0
;  15    C1       1      loPI   C5A     15      0     ; Kettenverlängerung
;  16    C1       1      loPI   C6A     16      0 	

[bonds]
;  i  j 	funct 	length 	force.c.
#ifdef FLEXIBLE
; Using bonds not constraints
   1  2 	1 	0.40 	30000 	
   1  3 	1 	0.40 	30000 	
   2  3 	1 	0.40 	30000 	
#endif
   1  4 	1 	0.35 	1250 	
   4  5 	1 	0.47 	1250 	
